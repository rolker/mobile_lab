<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro" name="molab">
  <xacro:arg name="namespace" default="molab"/>
  <xacro:property name="namespace" value="$(arg namespace)" scope="global" />

  <link name="${namespace}/base_link">
    <visual>
        <geometry>
            <mesh filename="package://molab_description/models/meshes/Mobile Lab 3D Model.dae"/>
        </geometry>
        <origin rpy="0 0 -1.57075" xyz="0 0 0"/>
    </visual>
  </link>

  <link name="${namespace}/ais">
    <visual>
      <geometry>
        <cylinder length="0.5" radius="0.01"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 0.25"/>
    </visual>
  </link>

  <joint name="${namespace}/base_to_ais" type="fixed">
      <parent link="${namespace}/base_link"/>
      <child link="${namespace}/ais"/>
      <origin rpy="0 0 0" xyz="5.75 -0.25 2.9" />
  </joint>

</robot>
